# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Lock files (remover para evitar erro npm ci no Coolify)
package-lock.json
server/package-lock.json
client/package-lock.json

# Production builds
client/build/
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env

# Runtime secrets (gerados automaticamente no primeiro deploy)
server/data/.runtime-secrets.json
.runtime-secrets.json

# Database
*.sqlite
*.sqlite-shm
*.sqlite-wal
server/database.sqlite*
# Os backups nomeiam o arquivo como "database-<timestamp>-shm/-wal", sem ".sqlite" no
# meio, então os padrões acima não pegavam e eles ficavam untracked-mas-não-ignorados —
# prontos para entrar num `git add -A` por acidente (megabytes de binário por commit).
server/data/backups/*-shm
server/data/backups/*-wal

# A rotina de backup grava "database-2026-08-06T14-36-25-wal", SEM o .sqlite no
# nome — os padroes acima nao pegavam, e 211 arquivos com dado de cliente
# (e-mail, CNPJ) acabaram versionados num repositorio publico.
# A pasta inteira de backup fica de fora: nada ali deve ir para o Git.
server/data/backups/
*-wal
*-shm

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2-*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Uploads gerados em runtime pelo proprio app (foto de material, foto de
# proposta). O padrao antigo apontava para "server/uploads/", que nao e o
# caminho que o codigo usa — o multer grava em server/data/uploads/. Resultado:
# arquivo enviado por usuario aparecia untracked-mas-nao-ignorado, pronto para
# entrar num add por acidente. Mesma armadilha dos backups logo acima.
server/data/uploads/

# Deploy
deploy/

# Nixpacks gerados automaticamente
.nixpacks/

.superpowers/

# Worktrees de agente (Claude Code). Sao copias completas do repo — 89 MB cada — e
# carregam server/index.js com a credencial SMTP em claro. Nao versionar.
.claude/worktrees/
